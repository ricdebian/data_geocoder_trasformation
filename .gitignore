# Datos descargados y resultados derivados; no versionar ficheros pesados.
/datos_espaciales/*
!/datos_espaciales/.gitkeep
/work/

# Formatos espaciales y sus archivos auxiliares; no versionar datos geográficos.
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.qpj
*.gpkg
*.geojson
*.pbf
*.kml
*.kmz
*.gdb/
*.sqlite
*.sqlite3
*.tif
*.tiff

# Paquetes comprimidos y archivos descargados; no versionar binarios.
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
